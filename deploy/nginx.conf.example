# Ejemplo de configuración Nginx para servir el sitio estático de bbbsc.com
# Copiar a /etc/nginx/sites-available/bbbsc.com y crear symlink en sites-enabled.
# Ajustar `root` a la ruta donde se copie el contenido de dist/ en el VPS.

server {
    listen 80;
    listen [::]:80;
    server_name bbbsc.com www.bbbsc.com;

    # Redirigir a HTTPS (requiere certificado, ver certbot más abajo)
    return 301 https://bbbsc.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.bbbsc.com;

    ssl_certificate     /etc/letsencrypt/live/bbbsc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbbsc.com/privkey.pem;

    return 301 https://bbbsc.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bbbsc.com;

    root /var/www/bbbsc.com/current/dist;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/bbbsc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bbbsc.com/privkey.pem;

    # Cabeceras de seguridad
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://connect.facebook.net https://app.clientify.net; connect-src 'self' https://www.google.com https://www.gstatic.com https://*.google-analytics.com https://connect.facebook.net https://www.facebook.com https://app.clientify.net; frame-src 'self' https://www.google.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests" always;

    # Compresión
    gzip on;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 512;

    # Assets con hash: cache larga e inmutable
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # robots.txt, sitemap.xml y favicon: cache corta
    location ~* \.(?:robots\.txt|sitemap\.xml|favicon\.svg)$ {
        expires 1h;
        add_header Cache-Control "public";
    }

    # Backend (server/): recibe los comentarios del blog y llama a Clientify.
    # Corre como proceso Node persistente en 127.0.0.1:4000 (ver ../server/README.md).
    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Sitemap dinámico: incorpora nuevas entradas y ofertas creadas en la intranet.
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:4000/api/sitemap.xml;
        proxy_set_header Host $host;
        expires 1h;
    }

    # SPA fallback: cualquier ruta que no sea un archivo real cae en index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
