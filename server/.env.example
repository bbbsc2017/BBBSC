# Copia este archivo a ".env" (nunca lo subas a git) y completa los valores reales.

# API key privada de Clientify (Configuración > API en tu cuenta de Clientify).
# NUNCA la pongas en el código del frontend: este backend es el único lugar donde debe vivir.
CLIENTIFY_API_KEY=

# Puerto donde corre este servicio (OpenLiteSpeed/Nginx lo exponen por detrás en /api/).
PORT=4000

# Dominio(s) desde los que se permite llamar a este backend (CORS), separados por coma.
# En local usa http://localhost:5173. En producción usa https://bbbsc.com
ALLOWED_ORIGINS=http://localhost:5173,https://bbbsc.com
