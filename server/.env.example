# Copia este archivo a ".env" (nunca lo subas a git) y completa los valores reales.

# API key privada de Clientify (Configuración > API en tu cuenta de Clientify).
# NUNCA la pongas en el código del frontend: este backend es el único lugar donde debe vivir.
CLIENTIFY_API_KEY=

# Opcional: si quieres que las oportunidades de ofertas entren en un pipeline y
# una etapa específicos de Clientify. Si se omiten, Clientify usa sus valores predeterminados.
CLIENTIFY_OFFERS_PIPELINE_ID=
CLIENTIFY_OFFERS_PIPELINE_STAGE_ID=

# Secret key privada vinculada a VITE_RECAPTCHA_SITE_KEY. Se obtiene en
# Google Cloud reCAPTCHA > tu clave > Integration > third-party integration.
# Nunca la pongas en el frontend ni en GitHub.
RECAPTCHA_SECRET_KEY=

# Puntaje mínimo aceptado para acciones públicas (0.0 a 1.0).
RECAPTCHA_MIN_SCORE=0.5

# Puerto donde corre este servicio (OpenLiteSpeed/Nginx lo exponen por detrás en /api/).
PORT=4000

# Dominio(s) desde los que se permite llamar a este backend (CORS), separados por coma.
# En local usa http://localhost:5173. En producción usa https://bbbsc.com
ALLOWED_ORIGINS=http://localhost:5173,https://bbbsc.com

# Activa esto solo si el proxy elimina /api/ al reenviar al puerto de Node.
# aaPanel + OpenLiteSpeed suele trabajar de esta forma con un contexto /api/.
PROXY_STRIPS_API_PREFIX=false

# Cadena aleatoria larga usada para firmar la cookie de sesión de la intranet
# y cifrar el token central que mantiene el navegador reconocido durante 15 días.
# Genera una nueva con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cadena aleatoria larga usada para anonimizar (hash) las IPs guardadas en el panel de visitas.
# Genera una nueva con el mismo comando que SESSION_SECRET (usa una distinta).
VISITS_HASH_SECRET=

# URL base de la API central de BBBSC (identidad, roles, participantes). El login,
# roles y permisos de la intranet vienen de aquí — bbbsc_com no guarda contraseñas.
BBBSC_API_URL=https://api.bbbsc.com

# 'production' en el VPS: hace que la cookie de sesión de la intranet requiera HTTPS.
NODE_ENV=development

# Rutas persistentes opcionales. Los valores por defecto son relativos a server/.
# En el VPS, el despliegue enlaza data/ y uploads/ a directorios compartidos.
DB_DIR=data
UPLOADS_DIR=uploads

# Notificaciones por correo cuando un participante aplica a una oferta. El VPS
# envía los mensajes mediante su Postfix local, por lo que no se guarda ninguna
# contraseña de correo en este proyecto.
OFFER_APPLICATION_NOTIFICATION_ENABLED=false
OFFER_APPLICATION_NOTIFICATION_FROM=info@bbbsc.com
OFFER_APPLICATION_NOTIFICATION_TO=danielgonzalez@bbbsc.com,accounts@bbbsc.com
# SENDMAIL_PATH=/usr/sbin/sendmail
